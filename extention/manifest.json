{
  "manifest_version": 3,
  "name": "Chat Orchestrator Bridge",
  "version": "0.1.3",
  "description": "Lets an orchestrator chat (Claude/ChatGPT) spawn and talk to worker chat tabs through a local MCP server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "reference-exporter/adapters/chatgpt/hook-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "reference-exporter/adapters/chatgpt/hook-iso.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "reference-exporter/adapters/gemini/hook-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "reference-exporter/adapters/gemini/hook-iso.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "reference-exporter/core/utils.js",
        "reference-exporter/adapters/chatgpt/api.js",
        "reference-exporter/adapters/chatgpt/genui.js",
        "reference-exporter/adapters/chatgpt/normalize.js",
        "structured-reader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "reference-exporter/core/utils.js",
        "reference-exporter/adapters/claude/api.js",
        "reference-exporter/adapters/claude/widgets.js",
        "reference-exporter/adapters/claude/normalize.js",
        "structured-reader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "reference-exporter/core/utils.js",
        "reference-exporter/adapters/gemini/api.js",
        "reference-exporter/adapters/gemini/normalize.js",
        "structured-reader.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Chat Orchestrator",
    "default_popup": "popup.html"
  }
}
